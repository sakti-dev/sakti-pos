{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"esModuleInterop": true,
		"isolatedModules": true,
		"lib": ["ES2020"],
		"module": "ESNext",
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2020",
		"outDir": "dist",
		"rootDir": "src",
		"noEmit": true
	},
	"include": ["src"]
}

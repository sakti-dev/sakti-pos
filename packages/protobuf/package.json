{
  "name": "@repo/protobuf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./sync": "./src/proto/sync.ts"
  },
  "scripts": {
    "generate": "grpc_tools_node_protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src --ts_proto_opt=esModuleInterop=true,forceLong=number,outputServices=false,useExactTypes=false proto/sync.proto",
    "lint": "ultracite check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "protobufjs": "^7.5.4"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "grpc-tools": "^1.13.0",
    "ts-proto": "^2.8.3",
    "typescript": "5.9.2"
  }
}

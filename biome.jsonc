{
  "extends": ["ultracite/biome/core", "ultracite/biome/solid"],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "apps/pos-app/src/**",
      "apps/pos-app/vite.config.ts",
      "apps/pos-app/drizzle.config.ts",
      "apps/pos-app/tailwind.config.js",
      "apps/pos-app/postcss.config.js",
      "apps/new-design/src/**",
      "apps/new-design/vite.config.ts",
      "packages/sync-contract/src/**",
      "!!packages/protobuf/src",
      "*.json",
      "*.jsonc",
      "!!**/tauri-drizzle-proxy",
      "!!**/dist",
      "!!**/src-tauri/target",
      "!!**/vendor",
      "!!**/src-tauri/gen",
      "!!**/permissions/schemas",
      "!!packages/protobuf/src/proto",
      "!!**/node_modules",
      "!!**/drizzle/meta",
      "!!docs/external"
    ]
  },
  "javascript": {
    "globals": ["vi"]
  },
  "linter": {
    "rules": {
      "correctness": {
        "useImageSize": "off"
      },
      "style": {
        "noExportedImports": "off",
        "noNonNullAssertion": "off",
        "useFilenamingConvention": "off"
      },
      "suspicious": {
        "noEmptyBlockStatements": "off",
        "noUnknownAtRules": "off"
      },
      "performance": {
        "noNamespaceImport": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/new-design/src/components/layout/app-shell/sidebar.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    }
  ]
}

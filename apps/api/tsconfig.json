{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "es2022",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["./worker-configuration.d.ts", "bun"],
    "paths": {
      "@sync-contract/api-schema": [
        "../../packages/sync-contract/src/api-schema.ts"
      ]
    }
  },
  "include": ["worker-configuration.d.ts", "src/**/*.ts", "drizzle.config.ts"]
}

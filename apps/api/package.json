{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "bun run build:worker && wrangler deploy -c wrangler.standalone.jsonc",
    "cf-typegen": "wrangler types",
    "lint": "ultracite check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "sync:cleanup": "bun src/scripts/sync-cleanup.ts",
    "sync:simulate-product": "bun src/scripts/sync-simulate-product.ts",
    "gen:manifest": "node --import ./scripts/cf-workers-shim.mjs scripts/gen-manifest.mjs",
    "build:worker": "node --import ./scripts/cf-workers-shim.mjs scripts/build-worker.mjs",
    "preview": "wrangler dev -c wrangler.standalone.jsonc"
  },
  "dependencies": {
    "@elysia/cors": "next",
    "@libsql/client": "^0.17.3",
    "@sync-contract": "*",
    "arctic": "^3.6.0",
    "baresync": "file:../../vendor/baresync/packages/baresync",
    "drizzle-orm": "^0.45.2",
    "elysia": "2.0.0-beta.19",
    "narvik": "^0.2.16",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.6.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "exact-mirror": "1.2.6",
    "typebox": "1.3.2",
    "typescript": "5.9.2",
    "wrangler": "^4.87.0"
  }
}

#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
PROJECT_ROOT="$REPO_ROOT/apps/api"
cd "$PROJECT_ROOT"

TURSO_PORT=8080
DB_FILE="$REPO_ROOT/.db/api/local.db"
LOG_DIR="$REPO_ROOT/logs"
LOG_FILE="$LOG_DIR/api.log"

cleanup() {
	echo "Shutting down..."
	[[ -n "${TURSO_PID:-}" ]] && kill "$TURSO_PID" 2>/dev/null || true
	[[ -n "${WRANGLER_PID:-}" ]] && kill "$WRANGLER_PID" 2>/dev/null || true
	[[ -n "${STUDIO_PID:-}" ]] && kill "$STUDIO_PID" 2>/dev/null || true
	wait 2>/dev/null
}
trap cleanup EXIT INT TERM

mkdir -p "$(dirname "$DB_FILE")"
mkdir -p "$LOG_DIR"
: > "$LOG_FILE"

turso dev --port "$TURSO_PORT" --db-file "$DB_FILE" &
TURSO_PID=$!

for i in $(seq 1 30); do
	if command -v nc >/dev/null 2>&1 && nc -z 127.0.0.1 "$TURSO_PORT" 2>/dev/null; then
		break
	fi
	if command -v curl >/dev/null 2>&1 && curl -sf "http://127.0.0.1:$TURSO_PORT" >/dev/null 2>&1; then
		break
	fi
	sleep 0.5
done

echo "Turso ready, pushing schema..."
bunx drizzle-kit push

echo "Starting wrangler..."
npx wrangler dev > >(tee "$LOG_FILE") 2>&1 &
WRANGLER_PID=$!

echo "Starting drizzle-kit studio..."
bunx drizzle-kit studio &
STUDIO_PID=$!

wait

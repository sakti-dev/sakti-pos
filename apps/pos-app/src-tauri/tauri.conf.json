{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sakti-pos",
  "version": "0.1.0",
  "identifier": "com.sakti-dev.sakti-pos",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sakti POS",
        "width": 800,
        "height": 600,
        "fullscreen": true,
        "decorations": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**/*", "$APPCONFIG/asset-cache/**/*"]
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:;"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["sakti-pos-dev"],
          "appLink": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "deep-link:default",
    "image-pipeline:allow-pick-image",
    "image-pipeline:allow-compress-asset",
    "image-pipeline:allow-delete-asset",
    "image-pipeline:allow-get-asset-path",
    "log:default",
    "opener:default",
    "baresync:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://192.168.1.2:3001/**" },
        { "url": "http://localhost:3001/**" },
        { "url": "https://**" }
      ]
    }
  ]
}

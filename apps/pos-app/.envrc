# Load the repository-level Nix shell for host-side checks:
# cargo fmt/test, bun tests, Ultracite, adb/logcat.
#
# Android dev/build still stays in distrobox through scripts/dev and
# scripts/build-apk because SDK/NDK/Android Studio are intentionally not
# managed by this Nix shell.
source_up

# Optional: Automatic entry (commented out by default)
# If you want to automatically enter the box when you cd here, 
# you can uncomment the line below, but it can be annoying.
# distrobox enter dev

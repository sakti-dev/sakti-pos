#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_ROOT="${APP_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"
PROJECT_ROOT="${PROJECT_ROOT:-$APP_ROOT}"
PACKAGE="${PACKAGE:-com.sakti_dev.sakti_pos}"
DEVICE_SNAPSHOT_PATH="${DEVICE_SNAPSHOT_PATH:-/data/user/0/$PACKAGE/db-snapshots/latest.sqlite}"
HOST_SNAPSHOT_PATH="${HOST_SNAPSHOT_PATH:-$APP_ROOT/.db-snapshots/latest.sqlite}"
EXPORT_URI="${EXPORT_URI:-sakti-pos-dev://snapshot-export}"
SNAPSHOT_WAIT_SECONDS="${SNAPSHOT_WAIT_SECONDS:-30}"

mkdir -p "$(dirname "$HOST_SNAPSHOT_PATH")"

trigger_device_snapshot_export() {
    adb shell am start -W -a android.intent.action.VIEW -d "$EXPORT_URI" "$PACKAGE" >/dev/null
}

wait_for_device_snapshot() {
    local elapsed_seconds=0
    while ! doas waydroid shell -- test -s "$DEVICE_SNAPSHOT_PATH" >/dev/null 2>&1; do
        if (( elapsed_seconds >= SNAPSHOT_WAIT_SECONDS )); then
            echo "Timed out waiting for device DB snapshot at $DEVICE_SNAPSHOT_PATH" >&2
            return 1
        fi

        sleep 1
        elapsed_seconds=$((elapsed_seconds + 1))
    done
}

echo "Requesting DB snapshot export on device" >&2
doas waydroid shell -- rm -f "$DEVICE_SNAPSHOT_PATH"
trigger_device_snapshot_export
wait_for_device_snapshot

echo "Copying DB snapshot from Waydroid to $HOST_SNAPSHOT_PATH" >&2
TEMP_SNAPSHOT_PATH="$(mktemp "$(dirname "$HOST_SNAPSHOT_PATH")/.latest.sqlite.XXXXXX")"
trap 'rm -f "$TEMP_SNAPSHOT_PATH"' EXIT

doas waydroid shell -- cat "$DEVICE_SNAPSHOT_PATH" > "$TEMP_SNAPSHOT_PATH"
if [[ ! -s "$TEMP_SNAPSHOT_PATH" ]]; then
    echo "Device snapshot was not exported. Rebuild and reopen the app so the debug receiver is installed." >&2
    exit 1
fi

rm -f "$HOST_SNAPSHOT_PATH"
install -m 0644 "$TEMP_SNAPSHOT_PATH" "$HOST_SNAPSHOT_PATH"
trap - EXIT

echo "DB snapshot synced to $HOST_SNAPSHOT_PATH" >&2

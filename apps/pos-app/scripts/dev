#!/usr/bin/env bash

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PACKAGE="com.sakti_dev.sakti_pos"

echo "1) Build & run (keep data)"
echo "2) Build & run (clear data + uninstall first)"
echo ""
read -p "Choose [1/2]: " CHOICE

if [[ "$CHOICE" == "2" ]]; then
    echo "🗑️ Clearing app data and uninstalling..."
    adb shell pm clear "$PACKAGE" 2>/dev/null || true
    adb uninstall "$PACKAGE" 2>/dev/null || true
fi

echo "🧹 Cleaning up existing dev servers..."
fuser -k 1420/tcp 1421/tcp 2>/dev/null

distrobox enter dev -- /bin/bash -c "
    export ANDROID_HOME=\"\$HOME/Android/Sdk\"
    export NDK_HOME=\"\$ANDROID_HOME/ndk/26.1.10909125\"
    export JAVA_HOME=\"\$HOME/android-studio/jbr\"
    export PATH=\"\$PATH:\$ANDROID_HOME/platform-tools:\$ANDROID_HOME/cmdline-tools/latest/bin\"

    echo '🚀 Launching Tauri Dev...'
    cd ${PROJECT_ROOT}
    bun tauri android dev --no-watch
"
